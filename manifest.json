{
  "manifest_version": 3,
  "minimum_chrome_version": "127",
  "name": "__MSG_extension_name__",
  "version": "0.7.0",
  "description": "__MSG_extension_description__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extension_name__"
  },
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": [
        "i18n-catalogs.js",
        "i18n.js",
        "dtek-sites.js",
        "dtek-schedule.js",
        "address-identity.js",
        "address-settings.js",
        "dtek-popup-closer.js",
        "dtek-content-script.js"
      ],
      "matches": [
        "https://*.dtek-kem.com.ua/ua/shutdowns*",
        "https://*.dtek-krem.com.ua/ua/shutdowns*",
        "https://*.dtek-dnem.com.ua/ua/shutdowns*",
        "https://*.dtek-oem.com.ua/ua/shutdowns*",
        "https://*.dtek-dem.com.ua/ua/shutdowns*"
      ]
    }
  ]
}
